{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/fintracker/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/fintracker/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/fintracker/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/fintracker",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
