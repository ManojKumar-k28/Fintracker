{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/$",
      "status": 302,
      "headers": { "Location": "/fintracker/dashboard" }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/fintracker/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/fintracker/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/fintracker",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
